{
  "name": "vatternrundan-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Private, phone-first PWA to track and adapt a sub-9h Vatternrundan training plan.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "seed": "python3 scripts/parse_plan.py",
    "test:plan": "node scripts/test-personalized-plan.mjs",
    "test:ftp-estimator": "node scripts/test-ftp-estimator.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^1.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-pwa": "^0.20.5"
  }
}
